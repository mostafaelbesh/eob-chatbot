{
  "name": "eob-chatbot",
  "version": "1.0.0",
  "description": "RAG-over-documents EOB chatbot — Spec-Driven rewrite",
  "scripts": {
    "ingest":      "node src/ingest.js",
    "start":       "node src/server.js",

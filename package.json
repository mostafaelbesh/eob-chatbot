  },
  "dependencies": {
    "@anthropic-ai/sdk":     "^0.26.0",
    "@xenova/transformers":  "^2.17.2",
    "cors":                  "^2.8.5",
    "dotenv":                "^16.4.5",
    "express":               "^4.19.2",
    "pdf-parse":             "^1.1.1"
  }
}